**/.pytest_cache/
**/__pycache__/
*/.pytest_cache/
*/__pycache__/

venv/
.env
.env*
!.env.example
.mysql-fix-*.sql

# 运行时备份文件（.env.bak-*、*.bak-*.sql、dev_database.db.bak-* 等），一律不入库
*.bak-*

/logs/*
!/logs/.gitkeep

/certs/*
!/certs/.gitkeep

# 信任锚（各机器的 Node 证书）是运行时状态，只留目录占位；与 certs/ 同一写法
/pinned_certs/*
!/pinned_certs/.gitkeep
/runtime_cache/

docs/audit/*

*.db
*.sqlite
*.sqlite3
*.log
